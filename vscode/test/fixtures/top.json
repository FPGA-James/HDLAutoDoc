    "language": "vhdl",
    "module": {
        "name": "top",
        "line": 23,
        "description": "Sampler top level.\n\nCaptures samples from a converter clock into the system clock, runs a capture\nwindow under register control (APB in, through an AXI4-Lite register file)\nand sends the samples, and a second external byte stream, through packet\nfilters. The converter and system clocks are asynchronous to each other.",
        "wavedrom": [],
        "mermaid": [
            {
                "caption": "Top-level structure",
                "source": "flowchart LR\n  APB[s_apb] --> BR[apb_bridge] --> RG[axil_adapter + axil_regs]\n  RG -- start --> CT[sample_ctrl]\n  ADC[adc_data] --> CAP[sample_capture]\n  CT -- capture_en --> CAP\n  CAP --> SS[sample_stream] --> MA[m_axis]\n  EXT[s_ext] --> AP[axis_pipeline] --> ME[m_ext]\n  RG -- filter_enable, threshold --> SS\n  RG -- filter_enable, threshold --> AP"
            }
        ]
    },
