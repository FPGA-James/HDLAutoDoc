#!/usr/bin/env node
// A stand-in for a Chromium browser, steered by FAKE_BROWSER_MODE: ok | nofile | fail | hang.
// FAKE_BROWSER_ARGS: file the received arguments are written to, as JSON.
import { writeFileSync } from 'node:fs';

const args = process.argv.slice(2);
if (process.env.FAKE_BROWSER_ARGS) writeFileSync(process.env.FAKE_BROWSER_ARGS, JSON.stringify(args));
const mode = process.env.FAKE_BROWSER_MODE ?? 'ok';
const out = args.find((a) => a.startsWith('--print-to-pdf='))?.slice('--print-to-pdf='.length);

if (mode === 'hang') setInterval(() => {}, 1000);
else if (mode === 'fail') { process.stderr.write('Failed to launch the browser\n'); process.exit(1); }
else if (mode === 'ok' && out) writeFileSync(out, '%PDF-1.4 fake\n');
